//Compiling dialogues and scripts

LOAD_TRA ~Faren/translations/%LANGUAGE%/journals.tra~

COMPILE ~Faren/script/fhffix.baf~                          //Faren dialogue fixer
        ~Faren/script/fhfrn.baf~                           //Faren's script

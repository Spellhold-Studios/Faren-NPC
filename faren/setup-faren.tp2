        ~Faren/script/fhfcut1.baf~                         //Faren's kidnap cutscene
        ~Faren/script/fhfcut2.baf~                         //Ritual cutscene
        ~Faren/script/fhfvamp.baf~                         //Faren's vampire script
        ~Faren/script/fhfhal.baf~                          //Halmar's script

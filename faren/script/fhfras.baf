IF
InParty("FHFRN")
InParty("Rasaad")
See("FHFRN")
!StateCheck("Rasaad",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
OR(2)
Global("RasaadRomanceActive","GLOBAL",1)
Global("RasaadRomanceActive","GLOBAL",2)
GlobalGT("RasaadLovetalks","GLOBAL",9)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("FHFRasaadconflict","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHFRasaadconflict","GLOBAL",1)
RealSetGlobalTimer("FHFRasaad_conflict_timer","GLOBAL",NINE_HOURS)
END

IF
InParty("Rasaad")
InParty("FHFRN")
See(Player1)
See("Rasaad")
!StateCheck(Player1,CD_STATE_NOTVALID) 
!StateCheck("Rasaad",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
!AreaType(DUNGEON)
OR(2)
Global("RasaadRomanceActive","GLOBAL",1)
Global("RasaadRomanceActive","GLOBAL",2)
GlobalGT("RasaadLovetalks","GLOBAL",9)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("FHFRasaadconflict","GLOBAL",1)
RealGlobalTimerExpired("FHFRasaad_conflict_timer","GLOBAL")
THEN
RESPONSE #100
SetGlobal("FHFRasaadconflict","GLOBAL",2)
END

IF
InParty("Rasaad")
See(Player1)
!StateCheck(Player1,CD_STATE_NOTVALID) 
!StateCheck("Rasaad",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
!AreaType(DUNGEON)
Global("FHFRasaadconflict","GLOBAL",2)
THEN
RESPONSE #100
StartDialogueNoSet(Player1)
END
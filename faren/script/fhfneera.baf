IF
InParty("FHFRN")
InParty("Neera")
See("FHFRN")
!StateCheck("Neera",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
OR(2)
Global("NeeraRomanceActive","GLOBAL",1)
Global("NeeraRomanceActive","GLOBAL",2)
GlobalGT("NeeraLovetalks","GLOBAL",9)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("FHFNeeraconflict","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHFNeeraconflict","GLOBAL",1)
RealSetGlobalTimer("FHFNeera_conflict_timer","GLOBAL",NINE_HOURS)
END

IF
InParty("Neera")
InParty("FHFRN")
See(Player1)
See("FHFRN")
!StateCheck(Player1,CD_STATE_NOTVALID) 
!StateCheck("Neera",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
!AreaType(DUNGEON)
OR(2)
Global("NeeraRomanceActive","GLOBAL",1)
Global("NeeraRomanceActive","GLOBAL",2)
GlobalGT("NeeraLovetalks","GLOBAL",9)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("FHFNeeraconflict","GLOBAL",1)
RealGlobalTimerExpired("FHFNeera_conflict_timer","GLOBAL")
THEN
RESPONSE #100
SetGlobal("FHFNeeraconflict","GLOBAL",2)
END

IF
InParty("Neera")
InParty("FHFRN")
See(Player1)
See("FHFRN")
!StateCheck(Player1,CD_STATE_NOTVALID) 
!StateCheck("Neera",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
!AreaType(DUNGEON)
Global("FHFNeeraconflict","GLOBAL",2)
THEN
RESPONSE #100
StartDialogueNoSet(Player1)
END
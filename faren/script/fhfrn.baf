//Romance eligibility script
IF
InParty(Myself)
Global("FHFarenRomanceActive","GLOBAL",0)
Global("FHFarenMatch","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHFarenRomanceActive","GLOBAL",1)
SetGlobal("FHFarenMatch","GLOBAL",1)
SetGlobal("FHFarenLoveTalk","GLOBAL",1)
RealSetGlobalTimer("FHFarenTalkTimer","GLOBAL",1000)
END

//Friendship talk script

IF
InParty(Myself)
See(Player1)
Global("FHFarenFriend","GLOBAL",1)
!AreaType(DUNGEON)
!Global("Chapter","GLOBAL",5)
OR(8)
Global("FHFarenFriendTalk","GLOBAL",2)
Global("FHFarenFriendTalk","GLOBAL",4)
Global("FHFarenFriendTalk","GLOBAL",6)
Global("FHFarenFriendTalk","GLOBAL",8)
Global("FHFarenFriendTalk","GLOBAL",10)
Global("FHFarenFriendTalk","GLOBAL",12)
Global("FHFarenFriendTalk","GLOBAL",14)
//Friendtalk 8: triggered at rest
Global("FHFarenFriendTalk","GLOBAL",18)
RealGlobalTimerExpired("FHFarenTalkTimer","GLOBAL")
THEN
RESPONSE #100
PlaySong(0)
StartDialogueNoSet(Player1)
END

//FT1, FT2, FT3, FT4, FT5, FT6, FT7, FT9

IF
InParty(Myself)
Global("FHFarenFriend","GLOBAL",1)
!AreaType(DUNGEON)
!Global("Chapter","GLOBAL",5)
See(Player1)
!StateCheck(Player1,CD_STATE_NOTVALID)
CombatCounter(0)
OR(8)
Global("FHFarenFriendTalk","GLOBAL",1)
Global("FHFarenFriendTalk","GLOBAL",3)
Global("FHFarenFriendTalk","GLOBAL",5)
Global("FHFarenFriendTalk","GLOBAL",7)
Global("FHFarenFriendTalk","GLOBAL",9)
Global("FHFarenFriendTalk","GLOBAL",11)
Global("FHFarenFriendTalk","GLOBAL",13)
//Friendtalk 8: triggered at rest
Global("FHFarenFriendTalk","GLOBAL",17)
RealGlobalTimerExpired("FHFarenTalkTimer","GLOBAL")
THEN
RESPONSE #100
IncrementGlobal("FHFarenFriendTalk","GLOBAL",1)
END

//Romance talk script


Global("FHFarenLoveTalk","GLOBAL",8)
Global("FHFarenLoveTalk","GLOBAL",10)
Global("FHFarenLoveTalk","GLOBAL",12)
Global("FHFarenLoveTalk","GLOBAL",14)
Global("FHFarenLoveTalk","GLOBAL",16)
//LT9: triggered at rest (FHFarenLoveTalk at 18)
//LT10: triggered at rest (FHFarenLoveTalk at 20)
Global("FHFarenLoveTalk","GLOBAL",22)
Global("FHFarenLoveTalk","GLOBAL",24)
Global("FHFarenLoveTalk","GLOBAL",26)
Global("FHFarenLoveTalk","GLOBAL",28)
Global("FHFarenLoveTalk","GLOBAL",30)
Global("FHFarenLoveTalk","GLOBAL",32)
Global("FHFarenLoveTalk","GLOBAL",34)
Global("FHFarenLoveTalk","GLOBAL",36)
//LT19: triggered at rest (FHFarenLoveTalk at 38)
Global("FHFarenLoveTalk","GLOBAL",40)
RealGlobalTimerExpired("FHFarenTalkTimer","GLOBAL")
THEN
RESPONSE #100
PlaySong(0)
PlaySound("fhfmus")
StartDialogueNoSet(Player1)
END


//Saradush talk

IF
InParty(Myself)
See(Player1)
Global("FHFarenRomanceActive","GLOBAL",2)
!AreaType(DUNGEON)
!StateCheck(Player1,CD_STATE_NOTVALID)
!StateCheck(Myself,CD_STATE_NOTVALID)
CombatCounter(0)
Global("SaradushSacked","GLOBAL",1)
Global("FHFSaradush","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHFSaradush","GLOBAL",1)
END

IF
InParty(Myself)
!StateCheck(Player1,CD_STATE_NOTVALID)
!StateCheck(Myself,CD_STATE_NOTVALID)
Global("FHFSaradush","GLOBAL",1)
THEN
RESPONSE #100
PlaySong(0)
PlaySound("fhfmus")
StartDialogueNoSet(Player1)
END

//Faren's string fixer

IF
True()
THEN
RESPONSE #100
CutSceneId("FHFRN")
SetName(~Faren~)
SetPlayerSound(Myself,~I've had enough of this!~ [FHFSS1],MORALE)
SetPlayerSound(Myself,~You know what? This is actually pretty fun.~ [FHFSS2],HAPPY)
SetPlayerSound(Myself,~This may not be a democracy, but I have a couple of suggestions about what we could be doing...~ [FHFSS3],UNHAPPY_ANNOYED)
SetPlayerSound(Myself,~It may just be me, but is anyone else having an awful time?~ [FHFSS4],UNHAPPY_SERIOUS)
SetPlayerSound(Myself,~Right, I've had enough. You can shove it, I'm out of here.~ [FHFSS5],UNHAPPY_BREAKING_POINT)
SetPlayerSound(Myself,~Does this mean I've got to go out in front?~ [FHFSS6],LEADER)
SetPlayerSound(Myself,~We've got to sleep sometime...haven't we?~ [FHFSS7],TIRED)
SetPlayerSound(Myself,~Prison or here. Prison or here. Tough call.~ [FHFSS8],BORED)
SetPlayerSound(Myself,~You want a fight, you've got one!~ [FHFSS9],BATTLE_CRY1)
SetPlayerSound(Myself,~Win or die!~ [FHFSS10],BATTLE_CRY2)
SetPlayerSound(Myself,~You're not taking me down!~ [FHFSS11],BATTLE_CRY3)
SetPlayerSound(Myself,~You picked the wrong time to start a fight!~ [FHFSS12],BATTLE_CRY4)
SetPlayerSound(Myself,~Let's get this finished!~ [FHFSS13],BATTLE_CRY5)
SetPlayerSound(Myself,~~ [FHFSS14],DAMAGE)
SetPlayerSound(Myself,~~ [FHFSS15],DYING)
SetPlayerSound(Myself,~I - I need some help!~ [FHFSS16],HURT)
SetPlayerSound(Myself,~Oh, was that a rabbit? Damn, now I'm hungry.~,AREA_FOREST)
SetPlayerSound(Myself,~Lots of undesirables round here. Don't worry, I've got your back.~ [FHFSS18],AREA_CITY)
SetPlayerSound(Myself,~These places always just make me nervous.~ [FHFSS19],AREA_DUNGEON)
SetPlayerSound(Myself,~Heh, I wonder what we're going to get up to today?~ [FHFSS20],AREA_DAY)
SetPlayerSound(Myself,~Not to be a downer or anything, but are we going to get some sleep?~ [FHFSS21],AREA_NIGHT)
SetPlayerSound(Myself,~Yep?~ [FHFSS22],SELECT_COMMON1)
SetPlayerSound(Myself,~What is it?~ [FHFSS23],SELECT_COMMON2)
SetPlayerSound(Myself,~What do you want?~ [FHFSS24],SELECT_COMMON3)
SetPlayerSound(Myself,~Hey there.~ [FHFSS25],SELECT_COMMON4)
SetPlayerSound(Myself,~I'm listening.~ [FHFSS26],SELECT_COMMON5)
SetPlayerSound(Myself,~I'm here to help.~ [FHFSS27],SELECT_COMMON6)
SetPlayerSound(Myself,~I'm on it.~ [FHFSS28],SELECT_ACTION1)
SetPlayerSound(Myself,~I can do that.~ [FHFSS29],SELECT_ACTION2)
SetPlayerSound(Myself,~Not if you're going to be bossy about it.~ [FHFSS30],SELECT_ACTION3)
SetPlayerSound(Myself,~Well, I don't have any better ideas.~ [FHFSS31],SELECT_ACTION4)
SetPlayerSound(Myself,~All right.~ [FHFSS32],SELECT_ACTION5)
SetPlayerSound(Myself,~You're in charge.~ [FHFSS33],SELECT_ACTION6)
SetPlayerSound(Myself,~Sure thing.~ [FHFSS34],SELECT_ACTION7)
SetPlayerSound(Myself,~You're pretty damn persistent, aren't you?~ [FHFSS35],SELECT_RARE1)
SetPlayerSound(Myself,~Faren's the name, Faren's the game. Oh, wait...~ [FHFSS36],SELECT_RARE2)
SetPlayerSound(Myself,~Got you, you bastard!~ [FHFSS37],CRITICAL_HIT)
SetPlayerSound(Myself,~Bugger, bugger, bugger!~ [FHFSS38],CRITICAL_MISS)
SetPlayerSound(Myself,~Got a toothpick? Might do more than this.~ [FHFSS39],TARGET_IMMUNE)
SetPlayerSound(Myself,~Come on, I'm carrying enough as it is.~ [FHFSS40],INVENTORY_FULL)
SetPlayerSound(Myself,~They won't even know it's missing.~,PICKED_POCKET)
SetPlayerSound(Myself,~~,HIDDEN_IN_SHADOWS)
SetPlayerSound(Myself,~Damn, where was I?~ [FHFSS41],SPELL_DISRUPTED)
SetPlayerSound(Myself,~There we go. Now, anyone who steps on that deserves whatever they get.~ [FHFSS42],SET_A_TRAP)
SetPlayerSound(Myself,~Not this again!~,REACT_TO_DIE_GENERAL)
EndCutSceneMode()
END

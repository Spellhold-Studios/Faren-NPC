IF
InParty("FHFRN")
InParty("Hexxat")
See("FHFRN")
!StateCheck("Hexxat",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
OR(2)
Global("HexxatRomanceActive","GLOBAL",1)
Global("HexxatRomanceActive","GLOBAL",2)
GlobalGT("HexxatLovetalks","GLOBAL",9)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("FHFHexxatconflict","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHFHexxatconflict","GLOBAL",1)
RealSetGlobalTimer("FHFHexxat_conflict_timer","GLOBAL",NINE_HOURS)
END

IF
InParty(Myself)
InParty("Hexxat")
See(Player1)
See("Hexxat")
!StateCheck(Player1,CD_STATE_NOTVALID) 
!StateCheck("Hexxat",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
!AreaType(DUNGEON)
OR(2)
Global("HexxatRomanceActive","GLOBAL",1)
Global("HexxatRomanceActive","GLOBAL",2)
GlobalGT("HexxatLovetalks","GLOBAL",9)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("FHFHexxatconflict","GLOBAL",1)
RealGlobalTimerExpired("FHFHexxat_conflict_timer","GLOBAL")
THEN
RESPONSE #100
SetGlobal("FHFHexxatconflict","GLOBAL",2)
END

IF
InParty(Myself)
InParty("Hexxat")
See(Player1)
See("Hexxat")
!StateCheck(Player1,CD_STATE_NOTVALID) 
!StateCheck("Hexxat",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
!AreaType(DUNGEON)
Global("FHFHexxatconflict","GLOBAL",2)
THEN
RESPONSE #100
StartDialogueNoSet(Player1)
END

//Appended to Trademeet jail script

//Closing Faren's cell door

IF
Global("FHFJailChanges","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHFJailChanges","GLOBAL",1)
CloseDoor("DOOR05")
END

IF
Global("FHFarenFree","GLOBAL",1)
Global("FHFUnlockDoor","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHFUnlockDoor","GLOBAL",1)
OpenDoor("DOOR05")
END

//Spawning Faren. Note different levels depending on party experience

//Faren at 110000 XP

IF
Global("FHFarenExists","AR2009",0)
XPLT(Player1,150000)
THEN
RESPONSE #100
SetGlobal("FHFarenlvl9","GLOBAL",1)
SetGlobal("FHFarenExists","AR2009",1)
CreateCreature("FHFRN9",[513.139],2)
END

//Faren at 225000 XP

IF
Global("FHFarenExists","AR2009",0)
XPGT(Player1,149999)
XPLT(Player1,250000)
THEN
RESPONSE #100
SetGlobal("FHFarenlvl11","GLOBAL",1)
SetGlobal("FHFarenExists","AR2009",1)
CreateCreature("FHFRN11",[513.139],2)
END


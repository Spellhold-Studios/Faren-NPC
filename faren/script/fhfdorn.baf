IF
InParty("FHFRN")
InParty("Dorn")
See("FHFRN")
!StateCheck("Dorn",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
OR(2)
Global("DornRomanceActive","GLOBAL",1)
Global("DornRomanceActive","GLOBAL",2)
GlobalGT("DornLovetalks","GLOBAL",9)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("FHFDornconflict","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHFDornconflict","GLOBAL",1)
RealSetGlobalTimer("FHFDorn_conflict_timer","GLOBAL",NINE_HOURS)
END

IF
InParty("Dorn")
InParty("FHFRN")
See(Player1)
See("FHFRN")
!StateCheck(Player1,CD_STATE_NOTVALID) 
!StateCheck("Dorn",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
!AreaType(DUNGEON)
OR(2)
Global("DornRomanceActive","GLOBAL",1)
Global("DornRomanceActive","GLOBAL",2)
GlobalGT("DornLovetalks","GLOBAL",9)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("FHFDornconflict","GLOBAL",1)
RealGlobalTimerExpired("FHFDorn_conflict_timer","GLOBAL")
THEN
RESPONSE #100
SetGlobal("FHFDornconflict","GLOBAL",2)
END

IF
InParty("Dorn")
InParty("FHFRN")
See(Player1)
See("FHFRN")
!StateCheck(Player1,CD_STATE_NOTVALID) 
!StateCheck("Dorn",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
!AreaType(DUNGEON)
Global("FHFDornconflict","GLOBAL",2)
THEN
RESPONSE #100
StartDialogueNoSet("FHFRN")
END
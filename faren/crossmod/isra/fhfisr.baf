//Romance conflict

IF
InParty("FHFRN")
InParty("rh#Isra2")
See("FHFRN")
!StateCheck("rh#Isra2",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
OR(2)
Global("rh#IsraRomanceActive","GLOBAL",1)
Global("rh#IsraRomanceActive","GLOBAL",2)
GlobalGT("rh#IsraLovetalks","GLOBAL",10)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("FHFIsraconflict","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHFIsraconflict","GLOBAL",1)
RealSetGlobalTimer("FHFIsra_conflict_timer","GLOBAL",NINE_HOURS)
END

IF
InParty("FHFRN")
InParty("rh#Isra2")
See(Player1)
See("rh#Isra2")
!StateCheck(Player1,CD_STATE_NOTVALID) 
!StateCheck("rh#Isra2",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
!AreaType(DUNGEON)
OR(2)
Global("rh#IsraRomanceActive","GLOBAL",1)
Global("rh#IsraRomanceActive","GLOBAL",2)
GlobalGT("rh#IsraLovetalks","GLOBAL",10)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("FHFIsraconflict","GLOBAL",1)
RealGlobalTimerExpired("FHFIsra_conflict_timer","GLOBAL")
THEN
RESPONSE #100
SetGlobal("FHFIsraconflict","GLOBAL",2)
END

IF
InParty("rh#Isra2")
InParty("FHFRN")
See(Player1)
See("FHFRN")
!StateCheck(Player1,CD_STATE_NOTVALID) 
!StateCheck("rh#Isra2",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
!AreaType(DUNGEON)
Global("FHFIsraconflict","GLOBAL",2)
THEN
RESPONSE #100
StartDialogueNoSet(Player1)
END
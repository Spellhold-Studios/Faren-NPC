//Romance Conflict

//Solaufein romance conflict
IF
Global("FHFSolaRomanceConflict","GLOBAL",0)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
GlobalGT("SolaTalk","GLOBAL",13)
!AreaType(DUNGEON)
!StateCheck(Player1,CD_STATE_NOTVALID)
!StateCheck(Myself,CD_STATE_NOTVALID)
See(Player1)
CombatCounter(0)
InParty("Sola")
InParty("FHFRN")
THEN
RESPONSE #100
SetGlobal("FHFSolaRomanceConflict1","GLOBAL",1)
END

IF
InParty(Myself)
InParty("Sola")
!StateCheck(Player1,CD_STATE_NOTVALID)
!StateCheck(Myself,CD_STATE_NOTVALID)
Global("FHFSolaConflict1","GLOBAL",1)
THEN
RESPONSE #100
StartDialogueNoSet(Player1)
END

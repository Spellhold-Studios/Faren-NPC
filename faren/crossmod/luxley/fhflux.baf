//Romance conflict

IF
InParty(Myself)
InParty("FHLSEB")
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
GlobalGT("FHLSebFlirt","GLOBAL",4)
Global("FHFSebJealousTimer","GLOBAL",0)
Global("FHLSebJustFriends","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHFSebJealousTimer","GLOBAL",1)
RealSetGlobalTimer("FHFSebJealousTime","GLOBAL",350)
END

IF
InParty("FHFRN")
InParty("FHLSEB")
See(Player1)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
!StateCheck("FHLSEB",CD_STATE_NOTVALID)
!StateCheck(Player1,CD_STATE_NOTVALID)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
RealGlobalTimerExpired("FHFSebJealousTimer","GLOBAL")
Global("FHFSebJealous","GLOBAL",0)
!AreaType(DUNGEON)
CombatCounter(0)
THEN
RESPONSE #100
SetGlobal("FHFSebJealous","GLOBAL",1)
END

IF
InParty("FHFRN")
InParty("FHLSEB")
See(Player1)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
!StateCheck("FHLSEB",CD_STATE_NOTVALID)
Global("FHFSebJealous","GLOBAL",1)
THEN
RESPONSE #100
StartDialogueNoSet(Player1)
END

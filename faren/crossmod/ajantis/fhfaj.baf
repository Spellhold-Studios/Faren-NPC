//Romance Conflicts

//If PC is engaged to Ajantis

IF
InParty("FHFRN")
InParty("C#Ajantis")
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("C#AjantisEngaged","GLOBAL",1)
GlobalGT("FHFarenLoveTalk","GLOBAL",17)
Global("FHFAjanConflictTimerSetEngaged","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHFAjanConflictTimerSetEngaged","GLOBAL",1)
RealSetGlobalTimer("FHFAjantisConflictTimer","GLOBAL",200)
END

IF
InParty("FHFRN")
InParty("C#Ajantis")
See(Player1)
!StateCheck(Player1,CD_STATE_NOTVALID)
!StateCheck(Myself,CD_STATE_NOTVALID)
!StateCheck("C#Ajantis",CD_STATE_NOTVALID)
Global("C#AjantisEngaged","GLOBAL",1)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
RealGlobalTimerExpired("FHFAjantisConflictTimer","GLOBAL")
Global("FHFAjanConflictTimerSetEngaged","GLOBAL",1)
Global("FHFAjanConflict1","GLOBAL",0)
!AreaType(DUNGEON)
CombatCounter(0)
THEN
RESPONSE #100
SetGlobal("FHFAjanConflict1","GLOBAL",1)
END

//If PC is not engaged to Ajantis

//Conflict talk 1:

IF
InParty("FHFRN")
InParty("C#Ajantis")
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
!Global("C#AjantisEngaged","GLOBAL",1)
Global("C#AjantisRomanceActive","GLOBAL",1)
GlobalGT("FHFarenLoveTalk","GLOBAL",13)
Global("FHFAjanConflictTimerSet1","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHFAjanConflictTimerSet1","GLOBAL",1)
RealSetGlobalTimer("FHFAjantisConflictTimer","GLOBAL",200)
END

IF
InParty("FHFRN")
InParty("C#Ajantis")
See(Player1)
!StateCheck(Player1,CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
!StateCheck("C#Ajantis",CD_STATE_NOTVALID)
Global("C#AjantisRomanceActive","GLOBAL",1)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("FHFAjanConflictTimerSet1","GLOBAL",1)
RealGlobalTimerExpired("FHFAjanConflictTimer","GLOBAL")
Global("FHFAjanConflict2","GLOBAL",0)
!AreaType(DUNGEON)
CombatCounter(0)
THEN
RESPONSE #100
SetGlobal("FHFAjanConflict2","GLOBAL",1)
END

//Conflict talk 2:

IF
InParty("FHFRN")
InParty("C#Ajantis")
Global("FHFarenRomanceActive","GLOBAL",1)
Global("C#AjantisRomanceActive","GLOBAL",1)
!Global("C#AjantisEngaged","GLOBAL",1)
GlobalGT("FHFarenLoveTalk","GLOBAL",22)
Global("FHFAjanConflictTimerSet2","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHFAjanConflictTimerSet2","GLOBAL",1)
RealSetGlobalTimer("FHFAjantisConflictTimer","GLOBAL",500)
END

IF
InParty("FHFRN")
InParty("C#Ajantis")
See(Player1)
!StateCheck(Player1,CD_STATE_NOTVALID)
!StateCheck(Myself,CD_STATE_NOTVALID)
!StateCheck("C#Ajantis",CD_STATE_NOTVALID)
Global("C#AjantisRomanceActive","GLOBAL",1)
!Global("C#AjantisEngaged","GLOBAL",1)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
RealGlobalTimerExpired("FHFAjanConflictTimer","GLOBAL")
Global("FHFAjanConflictTimerSet2","GLOBAL",1)
Global("FHFAjanConflict3","GLOBAL",0)
!AreaType(DUNGEON)
CombatCounter(0)
THEN
RESPONSE #100
SetGlobal("FHFAjanConflict3","GLOBAL",1)
END

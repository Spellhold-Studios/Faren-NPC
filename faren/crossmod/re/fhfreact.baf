//Valygar

IF
InParty("FHFRN")
InParty("Valygar")
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("RE_Valygar","GLOBAL",1)
GlobalGT("RE_ValygarRomance","GLOBAL",10)
Global("FHF_RE_ValConf","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHF_RE_ValConf","GLOBAL",1)
RealSetGlobalTimer("FHF_RE_ValygarTimer","GLOBAL",1000)
END

IF
RealGlobalTimerExpired("FHF_RE_ValygarTimer","GLOBAL")
InParty("FHFRN")
InParty("Valygar")
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("RE_Valygar","GLOBAL",1)
Global("FHF_RE_ValConf","GLOBAL",1)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
!StateCheck("Valygar",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
See("Valygar")
THEN
RESPONSE #100
SetGlobal("FHF_RE_ValConf","GLOBAL",2)
END

IF
InParty("FHFRN")
InParty("Valygar")
Global("FHF_RE_ValConf","GLOBAL",2)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
!StateCheck("Valygar",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
See("Valygar")
THEN
RESPONSE #100
StartDialogueNoSet("Valygar")
END

//Initiating dialogue

IF
InParty(Myself)
!StateCheck(Myself,CD_STATE_NOTVALID)
!StateCheck(Player1,CD_STATE_NOTVALID)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
OR(24)
Global("FHF_RE_Ada","GLOBAL",1)
Global("FHF_RE_Aimi","GLOBAL",1)
Global("FHF_RE_Anishai","GLOBAL",1)
Global("FHF_RE_Bjornin","GLOBAL",1)
Global("FHF_RE_Bodhi","GLOBAL",1)
Global("FHF_RE_Chandra","GLOBAL",1)
Global("FHF_RE_Chanelle","GLOBAL",1)
Global("FHF_RE_Coran","GLOBAL",1)
Global("FHF_RE_Desharik","GLOBAL",1)
Global("FHF_RE_Edwin","GLOBAL",1)
Global("FHF_RE_Eldoth","GLOBAL",1)
Global("FHF_RE_Gaelan","GLOBAL",1)
Global("FHF_RE_Ilona","GLOBAL",1)
Global("FHF_RE_Isabelle","GLOBAL",1)
Global("FHF_RE_Jarlaxle","GLOBAL",1)
Global("FHF_RE_Lais","GLOBAL",1)

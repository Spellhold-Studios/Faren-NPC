//Romantic Encounters reactions

// Ada

IF
InParty(Myself)
See(Player1)
!StateCheck(Myself,CD_STATE_NOTVALID)
!StateCheck(Player1,CD_STATE_NOTVALID)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("RE_AdaFlirt","GLOBAL",1)
Global("FHF_RE_Ada","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHF_RE_Ada","GLOBAL",1)
END


//Conflict talk 1:

IF
InParty("FHFRN")
InParty("ADAngel")
Global("FHFarenRomanceActive","GLOBAL",1)
Global("ADAngelRomanceActive","GLOBAL",1)
GlobalGT("ADAngelLoveTalk","GLOBAL",6)
GlobalLT("ADAngelLoveTalk","GLOBAL",11)
Global("FHFAngConflictTimerSet1","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHFAngConflictTimerSet1","GLOBAL",1)
RealSetGlobalTimer("FHFAngConflictTimer","GLOBAL",200)
END

IF
InParty("FHFRN")
InParty("ADAngel")
See(Player1)
!StateCheck(Player1,CD_STATE_NOTVALID)
!StateCheck(Myself,CD_STATE_NOTVALID)
!StateCheck("ADAngel",CD_STATE_NOTVALID)
Global("ADAngelRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFAngConflictTimerSet1","GLOBAL",1)
RealGlobalTimerExpired("FHFAngConflictTimer","GLOBAL")
Global("FHFAngConflict1","GLOBAL",0)
!AreaType(DUNGEON)
CombatCounter(0)
THEN
RESPONSE #100
SetGlobal("FHFAngConflict1","GLOBAL",1)
END

//Conflict 2 Timer setting

IF
InParty("FHFRN")
InParty("ADAngel")
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("ADAngelRomanceActive","GLOBAL",1)
GlobalGT("ADAngelLoveTalk","GLOBAL",10)
Global("FHFAngConflictTimerSet2","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHFAngConflictTimerSet2","GLOBAL",1)
RealSetGlobalTimer("FHFAngConflictTimer","GLOBAL",500)
END

//Initiating dialogue

IF
InParty("FHFRN")
InParty("ADAngel")
See(Player1)
!StateCheck(Player1,CD_STATE_NOTVALID)
!StateCheck(Myself,CD_STATE_NOTVALID)
!StateCheck("ADAngel",CD_STATE_NOTVALID)
Global("FHFAngConflict1","GLOBAL",1)
THEN
RESPONSE #100
StartDialogueNoSet(Player1)
END

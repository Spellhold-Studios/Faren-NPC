//Arath romance conflict

IF
InParty("FHFRN")
InParty("Arath")
See("Arath")
!StateCheck("Arath",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
Global("LK#ArathRomanceActive","GLOBAL",1)
GlobalGT("LK#ArathLoveTalks","GLOBAL",32)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("FHFArathconflict","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHFArathconflict","GLOBAL",1)
RealSetGlobalTimer("FHFArath_conflict_timer","GLOBAL",500)
END

IF
InParty(Myself)
InParty("Arath")
See(Player1)
See("Arath")
!StateCheck(Player1,CD_STATE_NOTVALID)
!StateCheck("Arath",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
!AreaType(DUNGEON)
Global("LK#ArathRomanceActive","GLOBAL",1)
GlobalGT("LK#ArathLoveTalks","GLOBAL",32)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("FHFArathconflict","GLOBAL",1)
RealGlobalTimerExpired("FHFArath_conflict_timer","GLOBAL")
THEN
RESPONSE #100
SetGlobal("FHFArathconflict","GLOBAL",2)
END

IF
InParty(Myself)
InParty("Arath")
See(Player1)
See("Arath")
!StateCheck(Player1,CD_STATE_NOTVALID) 
!StateCheck("Arath",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
!AreaType(DUNGEON)
Global("FHFArathconflict","GLOBAL",2)
THEN
RESPONSE #100
StartDialogueNoSet(Player1)
END

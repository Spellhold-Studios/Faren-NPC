//Banters

CHAIN IF ~InParty("FHFRN")
See("FHFRN")
!StateCheck("FHFRN",CD_STATE_NOTVALID)
!StateCheck(Myself,CD_STATE_NOTVALID)
Global("FHFYas1","GLOBAL",0)~ THEN BYASRAEN FHFYas1
@0
DO ~SetGlobal("FHFYas1","GLOBAL",1)~
== BFHFRN @1
== BYASRAEN @2
== BFHFRN @3
== BYASRAEN @4
EXIT


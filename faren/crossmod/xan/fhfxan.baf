//Conflict talk 1:

IF
InParty("FHFRN")
InParty("O#Xan")
Global("FHFarenRomanceActive","GLOBAL",1)
Global("O#XanRomanceActive","GLOBAL",1)
GlobalGT("FHFarenLoveTalk","GLOBAL",13)
GlobalLT("FHFarenLoveTalk","GLOBAL",24)
Global("FHFXanConflictTimerSet1","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHFXanConflictTimerSet1","GLOBAL",1)
RealSetGlobalTimer("FHFXanConflictTimer","GLOBAL",200)
END

IF
InParty("FHFRN")
InParty("O#Xan")
See(Player1)
!StateCheck(Player1,CD_STATE_NOTVALID)
!StateCheck(Myself,CD_STATE_NOTVALID)
!StateCheck("O#Xan",CD_STATE_NOTVALID)
Global("O#XanRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFXanConflictTimerSet1","GLOBAL",1)
RealGlobalTimerExpired("FHFXanConflictTimer","GLOBAL")
Global("FHFXanConflict1","GLOBAL",0)
!AreaType(DUNGEON)
CombatCounter(0)
THEN
RESPONSE #100
SetGlobal("FHFXanConflict1","GLOBAL",1)
END

//Conflict talk 2:

IF
InParty("FHFRN")
InParty("O#Xan")
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("O#XanRomanceActive","GLOBAL",1)
GlobalGT("FHFarenLoveTalk","GLOBAL",22)
Global("FHFXanConflictTimerSet2","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHFXanConflictTimerSet2","GLOBAL",1)
RealSetGlobalTimer("FHFXanConflictTimer","GLOBAL",500)
END

IF
InParty("FHFRN")
InParty("O#Xan")
See(Player1)
!StateCheck(Player1,CD_STATE_NOTVALID)
!StateCheck(Myself,CD_STATE_NOTVALID)
!StateCheck("O#Xan",CD_STATE_NOTVALID)
Global("O#XanRomanceActive","GLOBAL",1)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
RealGlobalTimerExpired("FHFXanConflictTimer","GLOBAL")
Global("FHFXanConflictTimerSet2","GLOBAL",1)
Global("FHFXanConflict2","GLOBAL",0)
!AreaType(DUNGEON)
CombatCounter(0)
THEN
RESPONSE #100
SetGlobal("FHFXanConflict2","GLOBAL",1)
END

//Initiating talks

IF
InParty("FHFRN")
InParty("O#Xan")
See(Player1)
!StateCheck(Player1,CD_STATE_NOTVALID)
!StateCheck(Myself,CD_STATE_NOTVALID)
!StateCheck("O#Xan",CD_STATE_NOTVALID)
OR(2)
Global("FHFXanConflict1","GLOBAL",1)
Global("FHFXanConflict2","GLOBAL",1)
THEN
RESPONSE #100
StartDialogueNoSet(Player1)
END

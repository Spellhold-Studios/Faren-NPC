IF
InParty("FHFRN")
InParty("O#Bran")
See("FHFRN")
!StateCheck("O#Bran",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
OR(2)
Global("O#BranRomanceActive","GLOBAL",1)
Global("O#BranRomanceActive","GLOBAL",2)
GlobalGT("O#BranLovetalk","GLOBAL",2)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("FHFBranwenconflict","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHFBranwenconflict","GLOBAL",1)
RealSetGlobalTimer("FHFBranwen_conflict_timer","GLOBAL",NINE_HOURS)
END

IF
InParty(Myself)
InParty("O#Bran")
See(Player1)
See("O#Bran")
!StateCheck(Player1,CD_STATE_NOTVALID) 
!StateCheck("O#Bran",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
!AreaType(DUNGEON)
OR(2)
Global("O#BranRomanceActive","GLOBAL",1)
Global("O#BranRomanceActive","GLOBAL",2)
GlobalGT("O#BranLovetalk","GLOBAL",2)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("FHFBranwenconflict","GLOBAL",1)
RealGlobalTimerExpired("FHFBranwen_conflict_timer","GLOBAL")
THEN
RESPONSE #100
SetGlobal("FHFBranwenconflict","GLOBAL",2)
END

IF
InParty(Myself)
InParty("O#Bran")
See(Player1)
See("O#Bran")
!StateCheck(Player1,CD_STATE_NOTVALID) 
!StateCheck("O#Bran",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
!AreaType(DUNGEON)
Global("FHFBranwenconflict","GLOBAL",2)
THEN
RESPONSE #100
StartDialogueNoSet(Player1)
END

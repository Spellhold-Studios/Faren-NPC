//Initiating talks

IF
InParty("FHFRN")
InParty("Chloe")
See(Player1)
!StateCheck(Player1,CD_STATE_NOTVALID)
!StateCheck(Myself,CD_STATE_NOTVALID)
!StateCheck("Chloe",CD_STATE_NOTVALID)
OR(2)
Global("FHFChloeConflict1","GLOBAL",1)
Global("FHFChloeConflict2","GLOBAL",1)
THEN
RESPONSE #100
StartDialogueNoSet(Player1)
END

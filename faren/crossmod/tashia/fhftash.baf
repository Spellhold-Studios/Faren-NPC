//Tashia romance conflict

IF
InParty("FHFRN")
InParty("Tashia")
See("Tashia")
!StateCheck("Tashia",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
!Global("TashiaRomanceActive","GLOBAL",3)
Global("TashiaMatch","GLOBAL",1)
GlobalGT("TashiaInterestMatch","GLOBAL",2)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("FHFTashiaconflict","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("FHFTashiaconflict","GLOBAL",1)
RealSetGlobalTimer("FHFTashia_conflict_timer","GLOBAL",NINE_HOURS)
END

IF
InParty(Myself)
InParty("Tashia")
See(Player1)
See("Tashia")
!StateCheck(Player1,CD_STATE_NOTVALID) 
!StateCheck("Tashia",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
!AreaType(DUNGEON)
!Global("TashiaRomanceActive","GLOBAL",3)
Global("TashiaMatch","GLOBAL",1)
GlobalGT("TashiaInterestMatch","GLOBAL",2)
OR(2)
Global("FHFarenRomanceActive","GLOBAL",1)
Global("FHFarenRomanceActive","GLOBAL",2)
Global("FHFTashiaconflict","GLOBAL",1)
RealGlobalTimerExpired("FHFTashia_conflict_timer","GLOBAL")
THEN
RESPONSE #100
SetGlobal("FHFTashiaconflict","GLOBAL",2)
END

IF
InParty(Myself)
InParty("Tashia")
See(Player1)
See("Tashia")
!StateCheck(Player1,CD_STATE_NOTVALID) 
!StateCheck("Tashia",CD_STATE_NOTVALID)
!StateCheck("FHFRN",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
!AreaType(DUNGEON)
Global("FHFTashiaconflict","GLOBAL",2)
THEN
RESPONSE #100
StartDialogueNoSet(Player1)
END
